generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model VideoRequest {
  id          String   @id @default(uuid())
  keyword     String
  language    String
  style       String
  duration    String
  aspectRatio String
  status      String   @default("draft") // draft, processing, completed, failed
  generatedPrompt String? // The prompt generated by Gemini
  soraTaskId  String?  // ID returned by Kie.ai
  videoStatus String   @default("idle") // idle, processing, completed, failed
  videoUrl    String?  // Final video URL
  createdAt   DateTime @default(now())
}
